# Backboard
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_native_app_client_id
# Optional unless you want an API access token audience.
AUTH0_AUDIENCE=
# Do not set AUTH0_CLIENT_SECRET for the CLI Device Authorization Flow.
# Native Auth0 applications should use token endpoint authentication method "none".

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=custos

# Custos behavior
CUSTOS_BLOCK_ON=critical,high
CUSTOS_ALLOW_OVERRIDE=false
CUSTOS_AI_PATCHES=true
CUSTOS_AUDIT_ENABLED=true
